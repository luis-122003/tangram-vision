# ─── Secretos ───────────────────────────────────────────────────────────────
# Nunca se versiona un .env. Los ejemplos (.env.example) sí, y no llevan valores
# reales: son la plantilla que cada quien copia en su máquina.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets.json
credentials.json

# ─── Dependencias y compilados ──────────────────────────────────────────────
node_modules/
dist/
build/
venv/
.venv/
__pycache__/
*.pyc
*.tsbuildinfo

# ─── Modelos entrenados ─────────────────────────────────────────────────────
# Pesan cientos de MB y no pertenecen al repositorio.
*.pt
*.keras
*.h5
*.onnx

# ─── Android / Expo ─────────────────────────────────────────────────────────
.expo/
.gradle/
mobile/android/
mobile/ios/
*.apk
*.aab

# ─── Respaldos locales ──────────────────────────────────────────────────────
# Copias de seguridad hechas a mano antes de un cambio grande (archivo.bak-FECHA).
# Son útiles en la máquina y no pertenecen al historial: para eso está git, que ya
# guarda todas las versiones anteriores de cada archivo.
*.bak
*.bak-*
*.orig
*.old
*~

# ─── Registros y temporales ─────────────────────────────────────────────────
*.log
npm-debug.*
# Permisos y ajustes de Claude Code propios de cada máquina.
.claude/settings.local.json
.DS_Store
Thumbs.db

# Paquete del dataset sintetico para Colab: se regenera, y lleva un .pt dentro.
tangram_sintetico.zip
