{
  "expo": {
    "name": "Tangram IA",
    "slug": "tangram-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCF6E8"
    },
    "android": {
      "package": "com.usb.tangramia",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FCF6E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usb.tangramia",
      "infoPlist": {
        "NSCameraUsageDescription": "La app usa la cámara para fotografiar tu figura de Tangram y validarla.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que Tangram IA use la cámara para revisar tu figura armada.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCF6E8"
        }
      ]
    ],
    "extra": {
      "_comentario": "apiUrls son los atajos de servidor que la app ofrece en Ajustes, para no escribir la IP cada vez. Va vacía a propósito: una dirección solo sirve en la red donde se escribió, y publicarla describe esa red a cualquiera. Añade las tuyas así: { \"etiqueta\": \"Aula\", \"url\": \"http://192.168.1.10:8000\" }",
      "apiUrls": []
    }
  }
}
