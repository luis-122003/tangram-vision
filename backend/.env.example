# Plantilla de configuración del backend. Cópiala a `.env` y rellénala.
#
# `.env` NO se versiona (está en .gitignore) y no se comparte por chat ni por
# correo. Si alguno de sus valores aparece alguna vez en un documento o una
# captura, hay que darlo por comprometido y regenerarlo:
#     npm run rotar-secretos

PORT=8000
# 'production' activa por defecto HTTPS forzado y HSTS.
NODE_ENV=development

# ─── Base de datos ───────────────────────────────────────────────────────────
# NO uses root. Crea un usuario con permisos solo sobre esta base:
#     mysql -u root -p < backend/sql/crear-usuario.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tangram_app
DB_PASSWORD=
DB_NAME=tangram_ia
# Milisegundos a partir de los cuales una consulta se registra como lenta.
DB_SLOW_QUERY_MS=400

# ─── Sesiones ────────────────────────────────────────────────────────────────
# Dos secretos DISTINTOS: si se filtra el de acceso, no debe servir para
# fabricar tokens de refresco. Genera cada uno con:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El servidor no arranca si faltan o si son más cortos de 32 bytes.
JWT_SECRET=
REFRESH_SECRET=
# El de acceso viaja en cada petición, así que dura poco; el de refresco es el
# que sostiene la jornada sin volver a pedirle la clave al estudiante.
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=12h

# ─── Cifrado de datos personales ─────────────────────────────────────────────
# El nombre y el correo de los estudiantes (menores) se guardan cifrados con
# AES-256-GCM, y el correo lleva además un índice ciego (HMAC) para poder
# buscarlo en el login. Genera cada clave con:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CUIDADO: si se pierden, los datos cifrados son irrecuperables; si se cambian,
# hay que volver a cifrar la tabla. Guarda una copia en un gestor de contraseñas.
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# ─── Servicio de visión ──────────────────────────────────────────────────────
VISION_URL=http://127.0.0.1:8001
# Debe quedar por debajo del tope del cliente (45 s en la app móvil): si el que
# se rinde primero es el teléfono, el niño ve un error de red genérico en vez
# del mensaje que el backend sabe darle.
VISION_TIMEOUT_MS=40000

# ─── Supabase Storage ────────────────────────────────────────────────────────
# Dónde quedan las fotos que manda el estudiante, para que el docente pueda
# mirarlas junto al intento. Un IoU de 0,42 no dice si el niño armó mal la
# figura, si la foto salió movida o si había media mesa en el encuadre.
#
# Es OPCIONAL: sin SUPABASE_URL el sistema funciona como siempre —la foto se
# analiza y se descarta— y así un problema con el almacén nunca deja a un niño
# sin poder jugar.
#
# El bucket debe crearse PRIVADO. Son fotos de menores: no hay ninguna URL que
# funcione sin firmar, y las firmadas caducan en SUPABASE_SIGN_TTL segundos.
SUPABASE_URL=
# La clave service_role, NO la anon/publishable. Salta todas las políticas RLS,
# así que vive solo en el servidor y no la toca ningún cliente, igual que la
# contraseña de MySQL. Panel > Project Settings > API Keys > service_role.
# Si aparece en una captura o un documento, hay que rotarla desde el panel.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=intentos
# Vida de la URL firmada con la que el docente ve una foto. Un minuto basta para
# que el navegador la cargue y es poco para que el enlace, si acaba copiado en
# un chat, siga sirviendo a nadie.
SUPABASE_SIGN_TTL=60

# ─── Límites ─────────────────────────────────────────────────────────────────
# Tamaño máximo de la foto. Viaja en base64, que abulta un tercio más que el JPEG.
MAX_IMAGE_MB=12
# Peticiones por minuto y por IP para el conjunto de la API.
RATE_LIMIT_API=120
# /predict arranca el detector en cada llamada: se limita aparte, y por usuario
# (no por IP, porque un aula entera sale por la misma dirección).
RATE_LIMIT_PREDICT=20
# Intentos de inicio de sesión por IP en 15 minutos. El freno por cuenta, con
# bloqueo creciente, va aparte en src/security/intentos.ts.
RATE_LIMIT_LOGIN_IP=30
# Filas máximas que devuelve un listado. El cliente no puede pedir más.
PAGE_SIZE=100

# ─── Red ─────────────────────────────────────────────────────────────────────
# Orígenes de la web permitidos por CORS, separados por comas. En producción no
# debe quedar en '*'. La app móvil llega sin cabecera Origin y siempre se acepta.
ALLOWED_ORIGINS=http://localhost:5173
# Pon 1 cuando haya TLS delante (producción o proxy). En el aula, con el móvil
# hablando por IP en la red local, no lo hay: forzarlo dejaría la app sin conectar.
FORCE_HTTPS=0
# Nº de proxies de confianza delante del backend. 0 en local; 1 detrás de nginx.
# Con un valor mal puesto, el límite por IP deja de funcionar bien.
TRUST_PROXY=0

# ─── Catálogo semilla ────────────────────────────────────────────────────────
# Por defecto se lee del servicio de visión, que es donde lo usan --autotest y
# --calibrar. Ruta relativa a backend/.
# FIGURES_SEED=../vision-service/data/figures_seed.json
