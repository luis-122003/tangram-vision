# Backend en el servidor. Se copia a deploy/backend.env (no se versiona).
#
# La base de datos, la dirección del servicio de visión, CORS, HTTPS y el proxy
# NO van aquí: los fija docker-compose.yml, porque dependen del montaje y no de
# quien lo instala. La explicación de cada variable está en backend/.env.example.

# ─── Secretos ─── los genera deploy/generar-secretos.sh; no los escribas a mano.
# Guarda una copia de ENCRYPTION_KEY y BLIND_INDEX_KEY fuera del servidor: si se
# pierden, los nombres y correos de los estudiantes son irrecuperables.
JWT_SECRET=
REFRESH_SECRET=
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=12h
VISION_TIMEOUT_MS=40000
MAX_IMAGE_MB=12

# ─── Correo: Gmail con «contraseña de aplicación» ───────────────────────────
# Cuenta de Google > Seguridad > Verificación en dos pasos (activada) >
# Contraseñas de aplicaciones. Son 16 letras; pégalas sin espacios.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=
SMTP_FROM="Tangram IA <tucuenta@gmail.com>"
EMAIL_CODE_TTL=15m
EMAIL_CODE_RESEND=60s

# ─── Fotos de los intentos: Supabase Storage ─────────────────────────────────
# Bucket PRIVADO «intentos». La clave es la sb_secret_…, nunca la publishable.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=intentos
SUPABASE_SIGN_TTL=60

# ─── Límites ─────────────────────────────────────────────────────────────────
RATE_LIMIT_API=120
RATE_LIMIT_PREDICT=20
RATE_LIMIT_LOGIN_IP=30
RATE_LIMIT_REGISTER_IP=10
RATE_LIMIT_EMAIL_IP=20
ALLOW_SELF_REGISTRATION=1
PAGE_SIZE=100
DB_SLOW_QUERY_MS=400
