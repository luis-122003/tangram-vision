# Servicio de visión en el servidor. Se copia a deploy/vision.env.
# La explicación de cada valor está en vision-service/.env.example.

# Ruta dentro del contenedor: vision-service/models/ se monta en /app/models.
# Si el archivo no está, el servicio arranca en MODO DEMOSTRACIÓN y devuelve
# cifras inventadas: comprobar `yolo_weights` en https://<dominio>/api/health.
YOLO_WEIGHTS=models/tangram_formas_v2.pt
YOLO_CONF=0.25
YOLO_IMGSZ=640

MATCH_IOU=0.80
CLOSE_IOU=0.75
REQUIRE_INVENTORY=0

UNET_ENABLED=0
