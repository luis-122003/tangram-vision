# Se copia a .env en la RAÍZ del repositorio (docker compose lo lee de ahí).
# Las dos claves las rellena deploy/generar-secretos.sh; no hace falta tocarlas.

# El dominio sin https:// ni barra final. Con «localhost» se prueba todo en la
# máquina propia: Caddy usa un certificado interno en vez de Let's Encrypt.
DOMINIO=tangram-ia.me
# Let's Encrypt avisa a este correo si un certificado va a caducar sin renovarse.
ACME_EMAIL=tucorreo@gmail.com

MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Solo para probar en local: con «development» se siembran las cuentas de
# demostración (clave 1234). En el servidor, NUNCA: déjalo en production.
NODE_ENV=production
