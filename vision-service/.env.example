# Servicio de visión de Tangram IA.
#
# Aquí no hay credenciales de base de datos ni secretos de sesión: este servicio
# no toca MySQL ni autentica a nadie. Eso vive en backend/.env.

# Detector de fichas (YOLOv8s-seg). Es el único modelo del pipeline.
# Ojo: el nombre del archivo debe coincidir con el que está en models/.
YOLO_WEIGHTS=models/tangram_formas_v2.pt
YOLO_CONF=0.25
# Resolución a la que el detector reescala la foto. 640 es la resolución a la
# que se entrenó `tangram_formas_v2`, y por eso no se sube: agrandar la foto no
# añade detalle, cambia la escala aparente de las fichas respecto a lo que el
# modelo vio entrenando, y este detector distingue el triángulo grande del
# mediano y del pequeño precisamente por tamaño.
# (El modelo anterior sí mejoraba a 960: se entrenó sobre otro dataset.)
YOLO_IMGSZ=640

# Umbrales del validador geométrico.
#   MATCH_IOU  acierto mínimo para dar la figura por correcta
#   CLOSE_IOU  a partir de aquí se le dice al estudiante "vas bien, ajusta"
# Salen de `python tangram_validator.py --calibrar`, que mide cuánto se parecen
# entre sí las figuras del catálogo (20 desde el 6 de septiembre: las 14 de
# siempre más las 6 que se armaron de verdad en las fotos del dataset). La mayor
# confusión entre dos figuras DISTINTAS sigue siendo 0.741 (house contra arrow)
# —las seis nuevas no empeoran el techo; la peor de ellas es conejo_sentado
# contra ferryboat, 0.738—, así que los dos umbrales tienen que quedar por
# encima de ese techo. Con CLOSE_IOU=0.70 no lo estaban: seis parejas
# de figuras distintas se felicitaban mutuamente, y un niño que armaba la casa
# recibía un "vas bien" teniendo como objetivo la flecha.
# El techo de 0.741 es del CATÁLOGO, no del detector: son figuras genuinamente
# parecidas de silueta y ningún modelo las va a separar mejor.
# Por arriba no aprieta: un armado correcto da 0.985 o más, así que 0.80 no deja
# fuera a nadie (lo confirma la tabla de sensibilidad del propio --calibrar).
MATCH_IOU=0.80
CLOSE_IOU=0.75

# Si es 0, faltar o sobrar fichas se informa pero no invalida la figura. Sigue
# en 0, aunque el margen mejoró mucho: con `tangram_formas_v2` más la reparación
# geométrica de `reparar_cuadrilateros`, el inventario sale exacto en 98 de 112
# fotos reales (88 %), cuando antes no salía en ninguna. Pero en las 14 restantes
# el detector pierde una ficha, y no se le puede reprobar al estudiante un armado
# correcto por un fallo de la cámara. La revisión igual se le muestra.
REQUIRE_INVENTORY=0

# ─── U-Net/ResNet34: segunda opinión, apagada ────────────────────────────────
# El U-Net que antes producía la silueta. NO califica ni puede calificar: su
# salida es una máscara, y una máscara no sabe que falta el cuadrado ni que hay
# dos fichas montadas. Se enciende para *medir*: con UNET_ENABLED=1, cada
# respuesta trae un bloque `unet` con el IoU que habría dado su silueta sobre la
# misma foto, junto al que da la unión de las máscaras de YOLO.
#
# Cuesta TensorFlow, ~15 s de arranque y ~190 ms por foto (CPU; TensorFlow no
# usa GPU en Windows nativo), así que en el aula va apagado.
#
# Para el estudio completo sobre un lote de fotos:
#     python evaluar_siluetas.py fotos/ --csv resultados.csv
UNET_ENABLED=0
UNET_WEIGHTS=models/unet_tangram_model_resnet34.keras
UNET_THRESHOLD=0.5

# Puerto del servicio. El backend Node lo busca en VISION_URL.
PORT=8001
